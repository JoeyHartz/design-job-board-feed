{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "watchlist.schema.json",
  "title": "Watchlist entry",
  "description": "One company or job board the daily routine checks, stored as watchlist/<folder>/<id>.json. Allowed values are also listed in config/board.json, which is what the build script checks against.",
  "type": "object",
  "required": ["schemaVersion", "id", "company", "programs", "status", "method"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_\\-.~:@+]+$"},
    "company": {"type": "string", "minLength": 1},
    "programs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["ID", "GD", "UX"]}
    },
    "status": {"enum": ["active", "inactive", "error"]},
    "method": {"enum": ["greenhouse", "lever", "ashby", "bamboohr", "page", "board", "search"]},
    "sourceUrl": {"type": "string", "description": "Feed or page the routine fetches. Empty for search entries."},
    "careersUrl": {"type": "string"},
    "segment": {"type": "string"},
    "lastChecked": {"type": "string", "description": "YYYY-MM-DD of the last successful check, or empty."},
    "found": {"type": "integer", "minimum": 0, "description": "Running count of postings added from this entry."},
    "statusHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "status", "reason"],
        "properties": {
          "date": {"type": "string"},
          "status": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "previousStatus": {"type": "string"},
    "errorDetail": {"type": "string"}
  }
}
