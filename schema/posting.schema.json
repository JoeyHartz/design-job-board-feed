{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "posting.schema.json",
  "title": "Job board posting",
  "description": "One job posting, stored as postings/<folder>/<id>.json. Allowed values are also listed in config/board.json, which is what the build script checks against.",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "company", "programs", "url", "status", "firstSeen"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_\\-.~:@+]+$", "description": "Matches the filename without .json."},
    "title": {"type": "string", "minLength": 1},
    "company": {"type": "string", "minLength": 1},
    "programs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["ID", "GD", "UX"]}
    },
    "level": {"enum": ["Internship", "Co-op", "Entry-level"]},
    "term": {"type": "string"},
    "location": {"type": "string"},
    "region": {"enum": ["Chicago area", "Midwest", "Remote", "Elsewhere in US", "International"]},
    "pay": {"type": "string"},
    "deadline": {
      "type": "string",
      "anyOf": [{"const": ""}, {"pattern": "^\\d{4}-\\d{2}-\\d{2}$"}]
    },
    "url": {"type": "string", "pattern": "^http"},
    "source": {"type": "string"},
    "note": {"type": "string"},
    "status": {"enum": ["open", "pending", "closed", "hidden", "error"], "description": "pending: found by the routine, waiting for a person to approve it; not published."},
    "firstSeen": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "lastUpdated": {"type": "string"},
    "lastVerified": {"type": "string"},
    "closedAt": {"type": "string"},
    "closedReason": {"type": "string"},
    "statusHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "status", "reason"],
        "properties": {
          "date": {"type": "string"},
          "status": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "facts": {
      "type": "object",
      "description": "Key details in our own short words (duties, requirements, how to apply). Never pasted posting text."
    },
    "previousStatus": {"type": "string", "description": "Set by the build when it marks a file as an error; restored on repair."},
    "errorDetail": {"type": "string", "description": "Why the build marked this file as an error."}
  }
}
